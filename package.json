{
  "name": "graphwrangler",
  "private": true,
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "e2e": "pnpm --filter @graphwrangler/mcp e2e",
    "dev": "pnpm --parallel --filter @graphwrangler/server --filter ui dev",
    "build": "pnpm -r build"
  },
  "packageManager": "pnpm@10.22.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.7"
  }
}
